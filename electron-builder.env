# Loaded automatically by the electron-builder CLI (dotenv).
#
# Portable/NSIS 7z archives default to -mx=9 ("ultra"). Prefer level 1 for
# local iteration: measured packaging was 14s / 107 MiB versus level 3 at
# 21s / 100 MiB. Timings depend on hardware and caches. Set this environment
# variable in the calling shell to 3-9 when size matters more than speed.
ELECTRON_BUILDER_COMPRESSION_LEVEL=1
