{
  "name": "llm-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Local HTTP proxy and web console for inspecting OpenAI-compatible LLM traffic.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\" \"electron/**/*.ts\" \"test-node/**/*.ts\" \"scripts/**/*.ts\" --no-error-on-unmatched-pattern --max-warnings=0",
    "start": "node --enable-source-maps dist-node/src/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  }
}
