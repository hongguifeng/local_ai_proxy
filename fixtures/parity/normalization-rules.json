{
  "version": 1,
  "categories": {
    "timestamp": {
      "keys": [
        "timestamp",
        "started_timestamp",
        "started_at",
        "last_seen_at",
        "last_response_at",
        "created_at",
        "updated_at"
      ],
      "sort": "iso_datetime"
    },
    "port": {
      "keys": [
        "actual_listen_port",
        "client_port",
        "ephemeral_port"
      ],
      "sort": "number"
    },
    "path": {
      "keys": [
        "temp_path",
        "temporary_path",
        "resolved_config_path",
        "resolved_log_root"
      ],
      "sort": "string"
    }
  },
  "string_patterns": [
    {
      "category": "uuid",
      "pattern": "(?<![0-9a-fA-F])[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![0-9a-fA-F])"
    },
    {
      "category": "request_id",
      "pattern": "(?<![0-9a-fA-F])[0-9a-fA-F]{32}(?![0-9a-fA-F])"
    },
    {
      "category": "localhost_port",
      "pattern": "(?<=127\\.0\\.0\\.1:)(?:[3-9][0-9]{4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"
    }
  ],
  "json_output": {
    "ensure_ascii": false,
    "indent": 2,
    "sort_keys": true
  }
}
